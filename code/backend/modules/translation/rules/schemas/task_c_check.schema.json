      "type": "array"
    },
    "qe_status": {
      "anyOf": [
        {
          "const": "未评估",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qe Status"
    }
  },
  "required": [
    "issues"
  ],
  "title": "PromptCheckOutput",
  "type": "object"
}