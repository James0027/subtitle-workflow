            "omission",
            "addition",
            "number",
            "negation",
            "entity",
            "relationship",
            "address",
            "context",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "enum": [
            "BLOCK",
            "WARN",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_span": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Span"
        },
        "target_span": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Span"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "unit_id",
        "category",
        "severity",
        "detail"
      ],
      "title": "PromptCheckIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "issues": {
      "items": {
